<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- So a PackageVersion also binds packages that arrive transitively: pinning a
         vulnerable transitive forward otherwise needs an explicit reference in every
         project that happens to pull it in. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <!-- Azure integrations are config-gated optional paths; on-prem deployments run without them. -->
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="Azure.Core" Version="1.61.0" />
    <!-- Key Vault as a configuration provider (AddAzureKeyVault) for the few secrets a SaaS host
         needs; App Service Key Vault references are the alternative. -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <!-- The Event Grid system-event models moved out of the main package in 5.0.0 (which
         type-forwards them). Must never be paired with Azure.Messaging.EventGrid < 5.0.0. -->
    <PackageVersion Include="Azure.Messaging.EventGrid.SystemEvents" Version="1.1.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Certificates" Version="4.9.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <!-- Five-field Unix cron with time-zone and DST handling: the background-job scheduler's
         occurrences and the built-in schedules' startup check. -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- axe-core bound for .NET and Playwright: the static accessibility floor for the
         identity UI, on the same 4.12 line as the client suite's axe-core. -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.12.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!-- The ASP.NET Core packages, EF Core and the Microsoft.Extensions.* runtime packages move
         together on one 10.0.x servicing line, so no two of them disagree on a shared
         transitive dependency. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <!-- Pinned to the exact Roslyn version Microsoft.EntityFrameworkCore.Design depends on
         (its Workspaces dependency demands = 5.0.0). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- SQL Server access without EF Core, for the Queryex differential suite and the
         inspection tool's optional execution mode. Both compare or eyeball the engine's own
         emitted SQL, so anything between them and the server would blur what is being tested.
         Kept on the version Microsoft.EntityFrameworkCore.SqlServer resolves to, so the
         solution has exactly one SqlClient. A move to the 7.x line must add
         Microsoft.Data.SqlClient.Extensions.Azure in the same change: 7.x moved the Entra
         authentication modes there, and every one of them fails at runtime without it. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <!-- ICU MessageFormat: the only maintained .NET implementation of the syntax
         translators and every TMS already speak. Needed for grammatical gender, which
         composite formatting cannot express. -->
    <PackageVersion Include="MessageFormat" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- Transitive via EF Core Design. 10.0.7 (what it resolves to) carries several high
         severity advisories that fail the audit, which takes the migrations tooling down
         with it; pinned forward to the patched line. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Transitive via SqlClient (9.0.4), MailKit (10.0.0) and Cryptography.Xml. Every
         release through 10.0.12 carries denial-of-service advisories that fail the audit;
         pinned forward to the patched line. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- The relational model and migration operations alone, for the collation pin that
         Tellma.Core.Testing ships to every suite owning a migrations assembly. Kept on the version
         Microsoft.EntityFrameworkCore.SqlServer resolves to. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- The hierarchyid type mapping behind every tree's shadow Node column and the HierarchyId
         reader; on the same servicing line as the EF packages above, which it requires. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer.HierarchyId" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <!-- On-premises secrets as one file per key (Docker or Kubernetes secrets, systemd
         LoadCredential). -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.11" />
    <!-- MetricCollector<T> and FakeLogger. Versions on the dotnet/extensions line, not the
         runtime's, so this does not track the 10.0.x band above. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- The resource localizer factory Tellma.Core decorates with ICU rendering, and the
         IStringLocalizer<T> registrations. Outside the ASP.NET Core shared framework, so the
         migrator and worker hosts get it too; kept on the runtime's servicing line. -->
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <!-- Kept on the same 8.x line OpenIddict 7.x depends on to avoid diamond conflicts. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.0.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.5.0" />
    <PackageVersion Include="OpenIddict.Quartz" Version="7.5.0" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.5.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.5.0" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.5.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.16.0" />
    <!-- PDF first-page thumbnails (MIT), rendered through PDFium. Referenced by
         Tellma.Core.Imaging.PdfWorker only, the worker process Tellma.Core.Imaging starts per
         PDF: it, the processor and the Skia/PDFium natives below are the platform's one
         native-binary package set, kept out of Tellma.Core and out of every host process. -->
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <!-- PDFium builds (Apache-2.0) PDFtoImage 5.4.0 is compiled against, pinned at the version it
         declares: they parse every uploaded PDF, so a move is a deliberate, reviewed change on the
         PDFtoImage line rather than a transitive drift. Linux carries linux-x64 and linux-arm64
         (glibc and musl); Win32 carries win-x64 and win-arm64. -->
    <PackageVersion Include="bblanchon.PDFium.Linux" Version="152.0.7961" />
    <PackageVersion Include="bblanchon.PDFium.macOS" Version="152.0.7961" />
    <PackageVersion Include="bblanchon.PDFium.Win32" Version="152.0.7961" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.18.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Image normalisation and thumbnails (MIT). The native packages move in lockstep with the
         managed one: SkiaSharp refuses a native library of another milestone at load. PDFtoImage
         asks for 4.150.1 of each; transitive pinning lifts them to this line. The NoDependencies
         Linux build embeds what the stock Linux build loads from fontconfig, which Linux runners
         and containers lack. -->
    <PackageVersion Include="SkiaSharp" Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.152.1" />
    <!-- In-process SMTP endpoint for the MailKit protocol suite; no external infrastructure. -->
    <PackageVersion Include="SmtpServer" Version="11.1.0" />
    <!-- The first version patched against GHSA-q939-rpr3-3284; referenced only to lift the
         version Testcontainers still brings in transitively. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Libraries that expose xunit types (the sender conformance suite, shared test doubles)
         reference these two instead of the xunit.v3 metapackage, whose build targets fail any
         project that is not an executable test project. -->
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>
</Project>
