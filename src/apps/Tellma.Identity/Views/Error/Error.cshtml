@model ErrorViewModel
@inject IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["ErrorTitle"].Value;
}

<div class="tmi-centred">
    <span class="tmi-hero tmi-hero-error"><tmi-icon name="circle-x" class="tmi-icon-lg" /></span>
    <h1 class="tmi-title">@L["ErrorTitle"]</h1>
</div>

@* Both may be absent — this page is also the re-execute target for any status code, where it
   is a bare heading and nothing else. *@
@if (!string.IsNullOrEmpty(Model.Error) || !string.IsNullOrEmpty(Model.ErrorDescription))
{
    <div class="tmi-notice tmi-notice-error" role="group" aria-label="@L["StatusError"]">
        <tmi-icon name="circle-x" class="tmi-icon-lg" />
        <div class="tmi-notice-body">
            @if (!string.IsNullOrEmpty(Model.ErrorDescription))
            {
                <p class="tmi-notice-title">@Model.ErrorDescription</p>
            }
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <code>@Model.Error</code>
            }
        </div>
    </div>
}
