@page
@model Tellma.Identity.Areas.Identity.Pages.Manage.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["Profile"].Value;
}

<h1 class="tmi-title">@L["Profile"]</h1>

<partial name="../Shared/_StatusMessage" model="@(Model.StatusMessage)" />

<form method="post">
    <div class="tmi-field">
        <label class="tmi-label" for="displayName">@L["Name"]</label>
        <input class="tmi-input" id="displayName" name="DisplayName" type="text" value="@Model.DisplayName" />
    </div>
    <div class="tmi-field">
        <label class="tmi-label" for="locale">@L["Language"]</label>
        <select class="tmi-input" id="locale" name="Locale">
            @foreach (Tellma.Identity.Infrastructure.LanguageChoice language in Model.Languages)
            {
                <option value="@language.Culture" selected="@(Model.Locale == language.Culture)" lang="@language.Culture">@language.NativeName</option>
            }
        </select>
    </div>
    <button class="tmi-button tmi-button-primary" type="submit">@L["Save"]</button>
</form>
