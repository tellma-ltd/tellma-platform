@using System.Globalization
@using Microsoft.AspNetCore.Http.Extensions
@using Tellma.Identity.Infrastructure
@inject Tellma.Identity.Infrastructure.IBrandingResolver Branding
@inject Tellma.Identity.Infrastructure.LanguageCatalog Languages
@inject Microsoft.Extensions.Options.IOptions<Tellma.Identity.Options.TellmaIdentityOptions> Ui
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    Tellma.Identity.Infrastructure.BrandingInfo brand = Branding.Resolve(clientId: null);
    bool isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @brand.ProductName</title>
    @* Start the face this request will actually render before the stylesheets are even parsed.
       Without it the browser cannot learn the font URL until fonts.css has been fetched and
       read, which is late enough to show the fallback first and swap. The server already knows
       the culture, so exactly one face is preloaded rather than every script we ship. *@
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="@Url.Content(FontPreload.ForCulture(CultureInfo.CurrentUICulture))" />
    @* The brand faces and the emitted @tellma/core-ui-tokens build; identity.css consumes them.
       Per-tenant branding later means serving a different tokens file, not editing styles.
       asp-append-version stamps each URL with the asset's content hash, which is what lets the
       static-asset endpoint answer with an immutable year-long cache instead of revalidating
       on every reload. *@
    <link rel="stylesheet" href="~/_content/Tellma.Identity/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Tellma.Identity/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Tellma.Identity/css/identity.css" asp-append-version="true" />
</head>
<body>
    <main class="tmi-shell">
        <div class="tmi-card">
            <header class="tmi-brand">
                @if (brand.LogoPath is not null)
                {
                    <img src="@brand.LogoPath" alt="@brand.ProductName" height="28" />
                }
                <span class="tmi-brand-name">@brand.ProductName</span>
            </header>
            @RenderBody()
            @* The language picker and the legal links are chrome, not page content: every page
               gets them, and each renders only when there is more than nothing to show. *@
            @if (Languages.Offered.Count > 1)
            {
                <form class="tmi-language" method="post" action="@Url.Action("Set", "Culture")">
                    <input type="hidden" name="returnUrl" value="@Context.Request.GetEncodedPathAndQuery()" />
                    @foreach (LanguageChoice language in Languages.Offered)
                    {
                        if (string.Equals(language.Culture, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, StringComparison.Ordinal))
                        {
                            <span class="tmi-language-current" lang="@language.Culture">@language.NativeName</span>
                        }
                        else
                        {
                            <button class="tmi-link" type="submit" name="culture" value="@language.Culture" lang="@language.Culture">@language.NativeName</button>
                        }
                    }
                </form>
            }
            @if (Ui.Value.Ui.PrivacyPolicyUrl is { } privacyUrl || Ui.Value.Ui.TermsOfServiceUrl is not null)
            {
                <footer class="tmi-legal">
                    @if (Ui.Value.Ui.PrivacyPolicyUrl is { } privacy)
                    {
                        <a class="tmi-link" href="@privacy" target="_blank" rel="noopener">@L["PrivacyPolicy"]</a>
                    }
                    @if (Ui.Value.Ui.TermsOfServiceUrl is { } terms)
                    {
                        <a class="tmi-link" href="@terms" target="_blank" rel="noopener">@L["TermsOfService"]</a>
                    }
                </footer>
            }
        </div>
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
