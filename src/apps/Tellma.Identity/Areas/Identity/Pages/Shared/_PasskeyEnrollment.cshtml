@model string?
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L

@* The credential is posted back through this form's hidden field by passkey.js. The action is
   named rather than left to the current page, so any page that has already established the
   ceremony's user can run the ceremony in place instead of sending the user on to a second page
   carrying an identically labelled button. The model is the validated return URL. *@
<form method="post" id="passkey-form" asp-area="Identity" asp-page="/Account/RegisterPasskey"
      asp-route-returnUrl="@Model" data-creation-url="@Url.Action("CreationOptions", "PasskeyCeremony")">
    <input type="hidden" id="credential" name="Credential" />
    <button class="tmi-button tmi-button-primary" type="button" id="enroll-button">@L["RegisterPasskeyButton"]</button>
</form>

@* A ceremony the browser refuses reports here. The messages are rendered server-side so they
   stay localized and the strict CSP still forbids building strings in script. *@
<p class="tmi-error" id="passkey-error" hidden
   data-duplicate-message="@L["PasskeyAlreadyOnThisDevice"]"
   data-failed-message="@L["PasskeyEnrollFailed"]"></p>
