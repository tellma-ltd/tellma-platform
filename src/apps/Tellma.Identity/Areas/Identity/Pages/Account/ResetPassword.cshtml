@page
@model Tellma.Identity.Areas.Identity.Pages.Account.ResetPasswordModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = ViewContext.ModelState.IsValid
        ? L["ResetPassword"].Value
        : L["ErrorTitlePrefix"].Value + ": " + L["ResetPassword"].Value;
}

<h1 class="tmi-title">@L["ResetPassword"]</h1>

@if (!Model.IsValid)
{
    <div class="tmi-notice tmi-notice-error" role="group" aria-label="@L["StatusError"]">
        <tmi-icon name="circle-x" class="tmi-icon-lg" />
        <div class="tmi-notice-body">@L["InvitationInvalid"]</div>
    </div>
}
else
{
    <partial name="/Areas/Identity/Pages/Shared/_ErrorSummary.cshtml" />

    <form method="post">
        <input type="hidden" name="Code" value="@Model.Code" />
        <div class="tmi-field">
            <label class="tmi-label" for="Password">@L["Password"]</label>
            <p class="tmi-hint" id="password-hint">@L["PasswordHint"]</p>
            <input class="tmi-input" id="Password" name="Password" type="password"
                   autocomplete="new-password" required minlength="12"
                   aria-describedby="password-hint"
                   aria-invalid="@(ViewContext.ModelState.IsValid ? null : "true")" />
        </div>
        <button class="tmi-button tmi-button-primary" type="submit">@L["ResetPassword"]</button>
    </form>
}
