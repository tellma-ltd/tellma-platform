@page
@model Tellma.Identity.Areas.Identity.Pages.Account.InvitationModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["InvitationTitle"].Value;
}

<h1 class="tmi-title">@L["InvitationTitle"]</h1>

@if (!Model.IsValid)
{
    <p class="tmi-error">@L["InvitationInvalid"]</p>
}
else
{
    <p class="tmi-muted">@L["InvitationPrompt"]</p>

    @* The ceremony runs here rather than on a page this one links to: redeeming the invitation
       has already issued the credential-flow cookie the enrollment posts against, so a second
       page would only repeat this one's button under a different heading. *@
    <partial name="Shared/_PasskeyEnrollment" model="@(Model.ReturnUrl)" />
}

@if (Model.IsValid)
{
    @section Scripts {
        <partial name="Shared/_PasskeyScripts" />
        <script src="~/_content/Tellma.Identity/js/register-passkey.page.js"></script>
    }
}
