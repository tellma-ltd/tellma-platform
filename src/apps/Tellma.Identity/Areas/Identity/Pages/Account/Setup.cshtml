@page
@model Tellma.Identity.Areas.Identity.Pages.Account.SetupModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["SetupTitle"].Value;
}

<h1 class="tmi-title">@L["SetupTitle"]</h1>
<p class="tmi-muted">@L["SetupPrompt"]</p>

<form method="post">
    <div class="tmi-field">
        <label class="tmi-label" for="token">@L["SetupToken"]</label>
        <input class="tmi-input" id="token" name="Token" type="text" autocomplete="off" required />
    </div>
    <button class="tmi-button tmi-button-primary" type="submit">@L["Continue"]</button>
</form>

<div asp-validation-summary="All" class="tmi-error"></div>
