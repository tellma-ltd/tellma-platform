@page
@model Tellma.Identity.Areas.Identity.Pages.Account.RegisterPasskeyModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = ViewContext.ModelState.IsValid
        ? L["RegisterPasskeyTitle"].Value
        : L["ErrorTitlePrefix"].Value + ": " + L["RegisterPasskeyTitle"].Value;
}

<div class="tmi-centred">
    <span class="tmi-hero"><tmi-icon name="key-round" class="tmi-icon-lg" /></span>
</div>

<h1 class="tmi-title">@L["RegisterPasskeyTitle"]</h1>
<p class="tmi-lead">@L["RegisterPasskeyPrompt"]</p>

<partial name="/Areas/Identity/Pages/Shared/_ErrorSummary.cshtml" />
<partial name="/Areas/Identity/Pages/Shared/_StatusMessage.cshtml" model="@(Model.StatusMessage)" />

<partial name="/Areas/Identity/Pages/Shared/_PasskeyEnrollment.cshtml" model="@(Model.ReturnUrl)" />

@section Scripts {
    <partial name="Shared/_PasskeyScripts" />
    <script src="~/_content/Tellma.Identity/js/register-passkey.page.js"></script>
}
