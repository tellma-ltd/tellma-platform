@page
@model Tellma.Identity.Areas.Identity.Pages.Account.RegisterPasskeyModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["RegisterPasskeyTitle"].Value;
}

<h1 class="tmi-title">@L["RegisterPasskeyTitle"]</h1>
<p class="tmi-muted">@L["RegisterPasskeyPrompt"]</p>

<partial name="Shared/_StatusMessage" model="@(Model.StatusMessage)" />

@* The credential is posted back through this form's hidden field by passkey.js. *@
<form method="post" id="passkey-form" data-creation-url="@Url.Action("CreationOptions", "PasskeyCeremony")">
    <input type="hidden" id="credential" name="Credential" />
    <button class="tmi-button tmi-button-primary" type="button" id="enroll-button">@L["RegisterPasskeyButton"]</button>
</form>

@* A ceremony the browser refuses reports here. The messages are rendered server-side so they
   stay localized and the strict CSP still forbids building strings in script. *@
<p class="tmi-error" id="passkey-error" hidden
   data-duplicate-message="@L["PasskeyAlreadyOnThisDevice"]"
   data-failed-message="@L["PasskeyEnrollFailed"]"></p>

<div asp-validation-summary="All" class="tmi-error"></div>

@section Scripts {
    <partial name="Shared/_PasskeyScripts" />
    <script src="~/_content/Tellma.Identity/js/register-passkey.page.js"></script>
}
