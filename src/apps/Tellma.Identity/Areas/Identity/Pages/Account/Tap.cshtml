@page
@model Tellma.Identity.Areas.Identity.Pages.Account.TapModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["TapTitle"].Value;
}

<h1 class="tmi-title">@L["TapTitle"]</h1>
<p class="tmi-muted">@L["TapPrompt"]</p>

<form method="post">
    <div class="tmi-field">
        <label class="tmi-label" for="email">@L["Email"]</label>
        <input class="tmi-input" id="email" name="Email" type="email" inputmode="email" required value="@Model.Email" />
    </div>
    <div class="tmi-field">
        <label class="tmi-label" for="pass">@L["TapPass"]</label>
        <input class="tmi-input" id="pass" name="Pass" type="text" autocomplete="off" required />
    </div>
    <button class="tmi-button tmi-button-primary" type="submit">@L["Continue"]</button>
</form>

<div asp-validation-summary="All" class="tmi-error"></div>
