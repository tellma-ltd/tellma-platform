@page
@model Tellma.Identity.Areas.Identity.Pages.Account.ForgotPasswordModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["ForgotPassword"].Value;
}

<h1 class="tmi-title">@L["ForgotPassword"]</h1>

@if (Model.Submitted)
{
    @* Non-committal by design, and there is no way back from here. *@
    <div class="tmi-notice tmi-notice-info" role="status">
        <tmi-icon name="mail" class="tmi-icon-lg" />
        <div class="tmi-notice-body">@L["ResetLinkSent"]</div>
    </div>
}
else
{
    <p class="tmi-lead">@L["ForgotPasswordPrompt"]</p>
    <form method="post">
        <div class="tmi-field">
            <label class="tmi-label" for="Email">@L["Email"]</label>
            <div class="tmi-field-control">
                <tmi-icon name="mail" />
                <input class="tmi-input" id="Email" name="Email" type="email" inputmode="email"
                       dir="ltr" autocomplete="username" required placeholder="@L["EmailPlaceholder"]" />
            </div>
        </div>
        <button class="tmi-button tmi-button-primary" type="submit">@L["SendResetLink"]</button>
    </form>
}
