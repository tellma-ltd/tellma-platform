<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Standalone host for the Tellma Identity Server: composition, configuration, and hosting only — all identity behavior lives in Tellma.Identity.</Description>
    <UserSecretsId>88d475a6-96ca-47d3-9d9d-e9f1e45c9797</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tellma.Identity\Tellma.Identity.csproj" />
    <!-- The migrations assembly, so runtime migration apply works. Only the runtime EF provider
         flows in; the Design toolchain is private to the migrations project (its own dotnet-ef
         startup), so this host never ships it. -->
    <ProjectReference Include="..\Tellma.Identity.Migrations\Tellma.Identity.Migrations.csproj" />
    <!-- Email is composed here rather than in the engine: which transport carries a message is a
         deployment decision, and the engine only asks for IEmailSender. All three transports are
         registered and only the one named by Email:Provider is ever constructed, so a deployment
         switches transport by configuration alone. -->
    <ProjectReference Include="..\..\core\Tellma.Core.Email\Tellma.Core.Email.csproj" />
    <ProjectReference Include="..\..\connector\smtp\Tellma.Connector.Smtp.Adapter\Tellma.Connector.Smtp.Adapter.csproj" />
    <ProjectReference Include="..\..\connector\sendgrid\Tellma.Connector.SendGrid.Adapter\Tellma.Connector.SendGrid.Adapter.csproj" />
    <ProjectReference Include="..\..\connector\acs-email\Tellma.Connector.AcsEmail.Adapter\Tellma.Connector.AcsEmail.Adapter.csproj" />
    <!-- The webhook fronting the transports report delivery back through. Only the hosted
         providers ship a receiver; an SMTP relay reports nothing, so in an on-premise deployment
         this route simply has nothing registered behind it. -->
    <ProjectReference Include="..\..\core\Tellma.Core.Webhooks\Tellma.Core.Webhooks.csproj" />
    <!-- Azure Monitor exporting is config-gated; without configuration the OpenTelemetry
         pipeline runs with no exporter. -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
