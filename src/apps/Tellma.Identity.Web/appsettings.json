{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    // The trace id is in the template because it is the reference the error page shows a user,
    // and a deployment with no collector in front of it has nothing but this console to find it
    // in. Renders empty for anything logged outside a request, such as startup.
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj} {TraceId}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  // Behind a reverse proxy, honor X-Forwarded-For/-Proto — but only from the proxies listed
  // here. Startup fails when Enabled is true and both lists are empty, because an empty list
  // would make the middleware accept the header from any caller (spoofable client IPs).
  // "ForwardedHeaders": {
  //   "Enabled": true,
  //   "KnownProxies": [ "10.0.0.4" ],
  //   "KnownNetworks": [ "10.0.0.0/8" ]
  // },
  "TellmaIdentity": {
    "Mode": "Standalone",
    "Issuer": null,
    "ConnectionString": null,
    "Keys": {
      "Signing": { "Source": "None" },
      "Encryption": { "Source": "None" }
    },
    // A deployed host never migrates its store: an operator applies each release's migrations
    // before the engine deploys. When the store is missing, empty or behind, the startup store
    // check fails and quotes this command as the remedy.
    "Seed": {
      "MigrateCommand": "dotnet ef database update --project src/apps/Tellma.Identity.Migrations --startup-project src/apps/Tellma.Identity.Migrations --connection \"<connection string>\""
    }
  }
}
