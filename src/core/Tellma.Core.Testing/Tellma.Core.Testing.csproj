<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Test doubles and assertion helpers for the Tellma.Core.Abstractions contracts — the capturing email sender, its DI registrations, delivery-event builders, and the sender conformance suite every email transport must pass. Referenced by test projects only.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The conformance suite is xUnit test code that happens to ship in a library, so its members
         follow the repo's sentence_case_with_underscores test naming rather than the API-surface
         naming CA1707 enforces. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tellma.Core.Abstractions\Tellma.Core.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- ILoggerProvider and ILoggingBuilder, for the provider that routes logs into test output. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- The conformance suite is an abstract xUnit class, so xunit types are part of this
         package's public surface. It references the two component packages rather than the
         xunit.v3 metapackage, whose build targets fail any project that is not an executable
         test project. -->
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

</Project>
