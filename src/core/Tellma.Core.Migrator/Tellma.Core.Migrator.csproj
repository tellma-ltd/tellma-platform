<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Tellma's migrator adapter: the platform-owned catalog migrations (schema "catalog", history catalog.__EFMigrationsHistory) and their design-time factory, CatalogDesignTimeFactory. Referenced only by a distribution's migrator project, which it brings the EF Design packages to. It is its own dotnet-ef startup project: dotnet ef migrations add &lt;Name&gt; --project src/core/Tellma.Core.Migrator --startup-project src/core/Tellma.Core.Migrator --namespace Tellma.Core.Migrator.Migrations --output-dir Migrations</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tellma.Core\Tellma.Core.csproj" />
    <!-- The table-type operations' C# generator and design-time services, which dotnet-ef needs to
         scaffold the catalog's membership table type. The repository's Directory.Build.targets
         injects the DesignTimeServicesReference into this assembly, as the package's build targets
         do for a package consumer. -->
    <ProjectReference Include="..\Tellma.Core.EntityFrameworkCore.Design\Tellma.Core.EntityFrameworkCore.Design.csproj" />
    <!-- developmentDependency=true would keep the Design package out of a referencing project; the
         distribution's migrator scaffolds its tenant migrations through this one, so it flows. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
