<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The ASP.NET Core adapter of Tellma's runtime: AddTellma, UseTellma and MapTellma for a distribution's web host. The fixed request pipeline, the route groups and their conventions, the endpoint audit, the CSRF control, the tenant middleware and access filter, the authentication schemes and policies, the tenantless surfaces (the information document, health, the admin surface, the protected-resource metadata and the SPA), Data Protection, forwarded headers, Serilog and OpenTelemetry.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web stack: hosting, routing, authentication and authorization, health checks, Data
         Protection and static assets all ship in the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Tellma.Core\Tellma.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Tellma.Bearer scheme of the bearer surfaces (MCP, the public API, the control plane). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Structured logging from the Serilog section, request logging and the version enrichers. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Traces and metrics: the platform's meters and activity sources and the framework's
         instrumentation. No exporter: a host bundle adds the one its cloud uses. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <!-- The suite drives the audit's walk, the CSRF rules and the principal binding directly,
         which keeps those seams out of the public surface. -->
    <InternalsVisibleTo Include="Tellma.Core.AspNetCore.Tests" />
  </ItemGroup>

</Project>
