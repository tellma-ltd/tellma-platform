<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The source-generated PDFium P/Invokes of the PDF preflight pin the document buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Tellma's image processor: SkiaImageProcessor normalises uploaded images and renders thumbnails on SkiaSharp, with PDF first-page thumbnails through PDFtoImage (PDFium). The platform's only package carrying native binaries; composed explicitly by a host through AddTellmaSkia, and never referenced by Tellma.Core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tellma.Core.Abstractions\Tellma.Core.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The imaging libraries. SkiaSharp's managed package brings the Windows and macOS natives;
         the Linux natives are the NoDependencies build, so no fontconfig is needed on a server.
         PDFtoImage brings the PDFium natives (bblanchon.PDFium.*), pinned centrally. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- AddMetrics(), which registers the IMeterFactory the image instruments are created from. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <!-- Referenced directly for its [LoggerMessage] source generator. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Binds the processor's options from configuration. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keeps SkiaSharp's Windows native symbol files (about 100 MB per runtime) out of every
         consumer's build and publish output; imported for in-repo consumers by the repository's
         Directory.Build.targets, and packed for package consumers. -->
    <None Include="build\**" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- The suite holds the PDF render lock and inspects native-handle bookkeeping through
         internal seams, which keeps them out of the public surface. -->
    <InternalsVisibleTo Include="Tellma.Core.Imaging.Tests" />
  </ItemGroup>

</Project>
