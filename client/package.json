{
  "name": "tellma-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/serve.mjs showcase",
    "build": "node scripts/build.mjs",
    "build:showcase": "ng build showcase && node scripts/inject-font-preloads.mjs dist/showcase/browser",
    "test": "node scripts/test.mjs",
    "prelint": "tsc -b projects/core/tellma-core-tools",
    "lint": "eslint . && stylelint \"projects/**/*.css\" --allow-empty-input",
    "typecheck": "tsc -p projects/core/tellma-core/tsconfig.json && tsc -p projects/core/tellma-core-testing/tsconfig.json --noEmit && tsc -p projects/core/tellma-core-tools/tsconfig.spec.json && tsc -p projects/core/tellma-core-ui/tsconfig.lib.json --noEmit && tsc -p tools/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "prelint:test": "tsc -b projects/core/tellma-core-tools",
    "lint:test": "vitest run --config tools/vitest.config.mts",
    "e2e": "node scripts/e2e.mjs",
    "tokens:build-css": "tsx tools/tokens/build-css.mts",
    "tokens:check": "tsx tools/tokens/check.mts",
    "identity:copy-assets": "tsx tools/fonts/copy-identity-assets.mts",
    "prestart": "pnpm run tokens:build-css",
    "pree2e": "pnpm run tokens:build-css",
    "api:check": "node scripts/api-extractor.mjs --check",
    "api:approve": "node scripts/api-extractor.mjs --approve",
    "docs:build": "tsx tools/docs/build-docs.mts",
    "golden:approve": "tsx tools/goldens/generate-format-golden.mts",
    "size:check": "node scripts/bundle-size.mjs"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@angular/aria": "catalog:",
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@internationalized/date": "catalog:",
    "@jsverse/transloco": "catalog:",
    "lucide": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@capsizecss/metrics": "catalog:",
    "@eslint/js": "catalog:",
    "@fontsource-variable/noto-sans": "catalog:",
    "@fontsource-variable/noto-sans-arabic": "catalog:",
    "@fontsource/noto-sans-mono": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@playwright/test": "catalog:",
    "@tellma/core-tools": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "angular-eslint": "catalog:",
    "axe-core": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "ng-packagr": "catalog:",
    "postcss-value-parser": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "ts-morph": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
