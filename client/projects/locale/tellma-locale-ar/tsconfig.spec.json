/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/spec",
    /* These specs import library SOURCES through the workspace path
       mappings, so the program's common source directory sits two levels
       up. Stating it keeps the editor from guessing (and complaining);
       nothing is emitted from this config, so the layout it implies is
       inert. Do NOT narrow this to "." — the Angular compiler then drops
       referenced files and the unit build fails outright. */
    "rootDir": "../..",
    "types": ["vitest/globals"]
  },
  "include": ["**/*.spec.ts"]
}
