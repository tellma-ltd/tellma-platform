/*
 * The fixture app's TypeScript configuration. It extends the client
 * workspace's, whose path mappings resolve every @tellma package to its
 * sources, so the fixture builds without the packages being built first,
 * and @tellma/core's list of lazily loaded entry points, which a build from
 * sources compiles too since the framework loads them with import() through
 * a specifier the compiler does not follow.
 */
{
  "extends": ["../../../../../tsconfig.json", "../../../tellma-core/tsconfig.lazy-entry-points.json"],
  "compilerOptions": {
    "types": []
  },
  "include": ["src/main.ts"]
}
