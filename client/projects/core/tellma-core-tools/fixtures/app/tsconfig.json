/*
 * The fixture app's TypeScript configuration. It extends the client
 * workspace's, whose path mappings resolve every @tellma package to its
 * sources, so the fixture builds without the packages being built first.
 */
{
  "extends": "../../../../../tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  /*
   * The shell entry point is listed too: the framework loads it with
   * import() through a specifier the compiler does not follow, and a build
   * from sources compiles only what the program holds.
   */
  "files": ["src/main.ts", "../../../tellma-core/shell/public-api.ts"]
}
