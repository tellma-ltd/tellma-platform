{
  "name": "@tellma/core-ui",
  "version": "0.1.0",
  "description": "Tellma UI component library \u2014 tm-* form controls built on @angular/cdk + @angular/aria, signal-first, Signal Forms native.",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@angular/aria": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "type": "module",
  "tellma": {
    "budgetsInKb": {
      ".": 4,
      "./alert": 2,
      "./button": 2,
      "./calendar-ethiopic": 2,
      "./calendar-umalqura": 5,
      "./contracts": 1,
      "./date-picker": 14,
      "./files": 5,
      "./grid-engine": 15,
      "./grid": 35,
      "./image": 10,
      "./tree-grid": 8,
      "./input": 4,
      "./l10n": 8,
      "./menu": 6,
      "./modal": 6,
      "./number": 4,
      "./popover": 4,
      "./tooltip": 3,
      "./checkbox": 4,
      "./form-field": 4,
      "./private": 4,
      "./select": 8,
      "./spinner": 1,
      "./tabs": 4
    },
    "apiGoldens": {
      "exclude": ["./private"]
    },
    "docs": {
      "globalStyles": {
        "./button": "styles/tm-button.css",
        "./input": "styles/tm-input.css",
        "./number": "styles/tm-number.css"
      }
    }
  }
}
