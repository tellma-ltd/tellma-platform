/*
 * EDITOR, LINT AND TYPECHECK view of the package (no build uses it): every
 * file, specs included, with @tellma/core-ui resolved to its sources through
 * the workspace paths. The package build (tsconfig.lib.json) compiles against
 * the built @tellma/core-ui instead, as a consumer would.
 */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": ["**/*.ts"]
}
