{
  "render": [
    {
      "name": "a group renders the active slot",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"] },
      "shape": "PrimaryAndSecondary",
      "row": { "id": 5, "name": "Head office", "name2": "المكتب الرئيسي" },
      "slot": 2,
      "locale": "en",
      "calendar": "gc",
      "expected": "المكتب الرئيسي"
    },
    {
      "name": "an empty active slot falls back to the first",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"] },
      "shape": "PrimaryAndSecondary",
      "row": { "id": 6, "name": "Jeddah", "name2": null },
      "slot": 2,
      "locale": "en",
      "calendar": "gc",
      "expected": "Jeddah"
    },
    {
      "name": "an empty-text active slot falls back to the first",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"] },
      "shape": "All",
      "row": { "id": 6, "name": "Jeddah", "name2": "جدة", "name3": "" },
      "slot": 3,
      "locale": "en",
      "calendar": "gc",
      "expected": "Jeddah"
    },
    {
      "name": "a slot the shape does not admit reads the first",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"] },
      "shape": "Primary",
      "row": { "id": 6, "name": "Jeddah" },
      "slot": 2,
      "locale": "en",
      "calendar": "gc",
      "expected": "Jeddah"
    },
    {
      "name": "a prefix and a name join with the fixed separator",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "row": { "id": 7, "code": "1101", "name": "Cash" },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "1101 - Cash"
    },
    {
      "name": "the separator is never localized",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "PrimaryAndSecondary",
      "row": { "id": 7, "code": "1101", "name": "Cash", "name2": "النقد" },
      "slot": 2,
      "locale": "ar-SA-u-nu-latn",
      "calendar": "gc",
      "expected": "1101 - النقد"
    },
    {
      "name": "a name holding the separator keeps it after the first",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "row": { "id": 8, "code": "A1", "name": "Rent - Office" },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "A1 - Rent - Office"
    },
    {
      "name": "a prefix alone is the text",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "row": { "id": 7, "code": "1101", "name": null },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "1101"
    },
    {
      "name": "neither a name nor a prefix renders the fallback",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "row": { "id": 12, "code": null, "name": null },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "#12"
    },
    {
      "name": "a row with no name renders the fallback",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"] },
      "shape": "Primary",
      "row": { "id": 3 },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "#3"
    },
    {
      "name": "the fallback writes the id ungrouped",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"] },
      "shape": "Primary",
      "row": { "id": 12345 },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "#12345"
    },
    {
      "name": "an integer source formats in native digits on the client",
      "rule": { "key": "Id", "source": "SerialNumber", "sourceType": "integer" },
      "shape": "Primary",
      "row": { "id": 9, "serialNumber": 42 },
      "slot": 1,
      "locale": "ar-SA",
      "calendar": "gc",
      "expected": "٤٢",
      "clientOnly": true
    },
    {
      "name": "an integer source formats in Latin digits under the latn numbering",
      "rule": { "key": "Id", "source": "SerialNumber", "sourceType": "integer" },
      "shape": "Primary",
      "row": { "id": 9, "serialNumber": 42 },
      "slot": 1,
      "locale": "ar-SA-u-nu-latn",
      "calendar": "gc",
      "expected": "42"
    },
    {
      "name": "an integer source is never grouped",
      "rule": { "key": "Id", "source": "SerialNumber", "sourceType": "integer" },
      "shape": "Primary",
      "row": { "id": 9, "serialNumber": 1234567 },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "1234567"
    },
    {
      "name": "an integer source reads the first slot whatever the active one",
      "rule": { "key": "Id", "source": "SerialNumber", "sourceType": "integer" },
      "shape": "All",
      "row": { "id": 9, "serialNumber": 42 },
      "slot": 3,
      "locale": "en",
      "calendar": "gc",
      "expected": "42"
    },
    {
      "name": "the key as the source renders the id",
      "rule": { "key": "Id", "source": "Id", "sourceType": "integer" },
      "shape": "Primary",
      "row": { "id": 7 },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "7"
    },
    {
      "name": "a date source renders in the calendar's numeric style",
      "rule": { "key": "Id", "source": "PostedOn", "sourceType": "date" },
      "shape": "Primary",
      "row": { "id": 4, "postedOn": "2026-03-15" },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "3/15/2026"
    },
    {
      "name": "a date source carries no bidi controls in a right-to-left locale",
      "rule": { "key": "Id", "source": "PostedOn", "sourceType": "date" },
      "shape": "Primary",
      "row": { "id": 4, "postedOn": "2026-03-15" },
      "slot": 1,
      "locale": "ar-SA-u-nu-latn",
      "calendar": "gc",
      "expected": "15/3/2026"
    },
    {
      "name": "bidi controls are stripped from the text",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "row": { "id": 7, "code": "‏1101", "name": "‫Cash‬⁦⁩" },
      "slot": 1,
      "locale": "en",
      "calendar": "gc",
      "expected": "1101 - Cash"
    }
  ],
  "expansion": [
    {
      "name": "one language selects the first twin and the prefix",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "navigation": null,
      "columns": ["Id", "Name", "Code"]
    },
    {
      "name": "two languages select two twins",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "PrimaryAndSecondary",
      "navigation": null,
      "columns": ["Id", "Name", "Name2", "Code"]
    },
    {
      "name": "a navigation prefixes every column",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "All",
      "navigation": "Parent",
      "columns": ["Parent.Id", "Parent.Name", "Parent.Name2", "Parent.Name3", "Parent.Code"]
    },
    {
      "name": "a group without a third twin stops at the second",
      "rule": { "key": "Id", "twins": ["Name", "Name2", null] },
      "shape": "All",
      "navigation": null,
      "columns": ["Id", "Name", "Name2"]
    },
    {
      "name": "a scalar source is one column under every shape",
      "rule": { "key": "Id", "source": "SerialNumber", "sourceType": "integer" },
      "shape": "All",
      "navigation": "Document",
      "columns": ["Document.Id", "Document.SerialNumber"]
    },
    {
      "name": "the key as the source is the key alone",
      "rule": { "key": "Id", "source": "Id", "sourceType": "integer" },
      "shape": "All",
      "navigation": null,
      "columns": ["Id"]
    }
  ],
  "findableColumns": "search: the ids the findable branches of a search find, on the server (the id, an integer source or prefix, and the prefix-and-name split) and in the client's cached search alike; the searchable columns' contains match is in neither column. paste: the ids the paste resolver's exact match finds.",
  "findable": [
    {
      "name": "a pasted prefix and name find the row by both halves",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "PrimaryAndSecondary",
      "rows": [
        { "id": 7, "code": "1101", "name": "Cash", "name2": "النقد" },
        { "id": 11, "code": "1101", "name": "Cash float" },
        { "id": 12, "code": "1102", "name": "Cash" }
      ],
      "text": "1101 - Cash",
      "search": [7, 11],
      "paste": [7]
    },
    {
      "name": "the split matches the name in any admitted slot",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "PrimaryAndSecondary",
      "rows": [
        { "id": 7, "code": "1101", "name": "Cash", "name2": "النقد" },
        { "id": 12, "code": "1102", "name": "Cash", "name2": "النقد" }
      ],
      "text": "1101 - النقد",
      "search": [7],
      "paste": [7]
    },
    {
      "name": "a name holding the separator splits at the first one",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "rows": [
        { "id": 8, "code": "A1", "name": "Rent - Office" },
        { "id": 13, "code": "A1", "name": "Rent" },
        { "id": 14, "code": "Rent", "name": "Office" }
      ],
      "text": "A1 - Rent - Office",
      "search": [8],
      "paste": [8]
    },
    {
      "name": "a name holding the separator pasted alone also splits",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "rows": [
        { "id": 8, "code": "A1", "name": "Rent - Office" },
        { "id": 13, "code": "A1", "name": "Rent" },
        { "id": 14, "code": "Rent", "name": "Office" }
      ],
      "text": "Rent - Office",
      "search": [14],
      "paste": [8, 14]
    },
    {
      "name": "an integer source equals the text, and a search the bare id too",
      "rule": { "key": "Id", "source": "SerialNumber", "sourceType": "integer" },
      "shape": "Primary",
      "rows": [
        { "id": 1, "serialNumber": 42 },
        { "id": 42, "serialNumber": 7 },
        { "id": 3, "serialNumber": 420 }
      ],
      "text": "42",
      "search": [1, 42],
      "paste": [1]
    },
    {
      "name": "native digits read as Latin for an integer source, never for the id",
      "rule": { "key": "Id", "source": "SerialNumber", "sourceType": "integer" },
      "shape": "Primary",
      "rows": [
        { "id": 1, "serialNumber": 42 },
        { "id": 42, "serialNumber": 7 }
      ],
      "text": "٤٢",
      "search": [1],
      "paste": [1]
    },
    {
      "name": "an integer prefix equals the left half, native digits read as Latin",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Number", "prefixType": "integer" },
      "shape": "Primary",
      "rows": [
        { "id": 5, "number": 1101, "name": "Cash" },
        { "id": 6, "number": 1102, "name": "Cash" }
      ],
      "text": "١١٠١ - Cash",
      "search": [5],
      "paste": [5]
    },
    {
      "name": "the hash and the id find the row by its key",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "rows": [
        { "id": 7, "code": "1101", "name": "Cash" },
        { "id": 17, "code": "1117", "name": "Seven" }
      ],
      "text": "#7",
      "search": [7],
      "paste": [7]
    },
    {
      "name": "a bare id is searched, never pasted",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "rows": [
        { "id": 7, "code": "1101", "name": "Cash" },
        { "id": 17, "code": "1117", "name": "Seven" }
      ],
      "text": "7",
      "search": [7],
      "paste": []
    },
    {
      "name": "a pasted name ignores case, never accents",
      "rule": { "key": "Id", "twins": ["Name", "Name2", "Name3"], "prefix": "Code" },
      "shape": "Primary",
      "rows": [
        { "id": 21, "code": "C1", "name": "Café" },
        { "id": 22, "code": "C2", "name": "Cafe" }
      ],
      "text": "CAFÉ",
      "search": [],
      "paste": [21]
    },
    {
      "name": "a date source is never findable",
      "rule": { "key": "Id", "source": "PostedOn", "sourceType": "date" },
      "shape": "Primary",
      "rows": [{ "id": 2, "postedOn": "2026-03-01" }],
      "text": "2026-03-01",
      "search": [],
      "paste": []
    }
  ]
}
