// Units of work above their round-trip ceiling, per operation.
// Backs the "an operation takes more database round trips than its budget" alert, which finds an
// N+1 per operation: each request's unit of work is tagged "<resource>:<kind>", where the kind is
// the pipeline operation (query, save, action, ...) or the name of the API action that ran
// (me, check, ...). The exporter lands the histogram as per-interval sums, counts and maximums, so
// the hour's worst unit is compared with its kind's ceiling: one save at five round trips fires,
// where a mean over the hour would hide it among the twos.
//
// A kind's ceiling is the most it takes with a cold connect cache or a stale tag on top of its warm
// budget: the reads one more than their one, a save or an entity action its dependent-round
// maximum of four. Kinds not listed, a distribution's own API actions among them, are held to the
// fallback, the save ceiling. A transient failure's retry costs a round trip of its own, so a
// retried unit can fire the alert alone; that is the alert to look at, not to page on.
//
// Excluded: units of work outside any request (an empty tag), jobs ("job:<key>") and provisioning
// steps, whose round trips follow their work, and an Excel export's rows, which take one round
// trip per page.
let ceiling = datatable(kind: string, allowed: long)
[
    "query", 2,
    "get", 2,
    "get_by_ids", 2,
    "get_by_parent_ids", 2,
    "all", 2,
    "save", 4,
    "delete", 2,
    "delete_by_query", 2,
    "delete_with_descendants", 2,
    "action", 4,
    "api_action", 4,
    "me", 2,
    "me/save", 4,
    "me/locale", 2,
    "me/preferences/set", 2,
    "me/preferences/delete", 2,
    "invitation-status", 2,
    "preferences/get", 2,
    "check", 3,
    "holders", 2,
];
let fallback = 4;
customMetrics
| where name == "tellma.data.roundtrips"
| extend operation = tostring(customDimensions["operation"])
| where isnotempty(operation)
| extend owner = tostring(split(operation, ":")[0]), kind = tostring(split(operation, ":")[1])
| where owner != "job" and kind !in ("job", "provisioning", "excel_rows")
| summarize units = sum(valueCount), worst = max(valueMax) by operation, kind, bin(timestamp, 1h)
| lookup kind=leftouter ceiling on kind
| extend allowed = coalesce(allowed, fallback)
| where worst > allowed
