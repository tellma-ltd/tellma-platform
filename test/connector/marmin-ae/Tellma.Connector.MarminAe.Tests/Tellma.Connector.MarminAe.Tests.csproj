    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied whole rather than by extension, so promoting a sandbox recording over a stand-in is
         adding one file and never editing this project. Vectors\PROVENANCE.md says which is which. -->
    <None Update="Vectors\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
