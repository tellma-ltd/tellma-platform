<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\connector\marmin-ae\Tellma.Connector.MarminAe\Tellma.Connector.MarminAe.csproj" />
    <ProjectReference Include="..\..\..\shared\Tellma.Testing.Support\Tellma.Testing.Support.csproj" />
    <!-- The token provider's refresh margin and the client's per-request timeout are both driven
         off an injected clock, so nothing in this suite waits on a real one. -->
