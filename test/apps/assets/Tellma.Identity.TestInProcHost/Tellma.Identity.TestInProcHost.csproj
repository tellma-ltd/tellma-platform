<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Not an xunit project: a distribution-shaped web host asset that mounts the identity
         engine in-proc, exercised by the integration suite's composition-parity tests. -->
    <TellmaTestAsset>true</TellmaTestAsset>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\apps\Tellma.Identity\Tellma.Identity.csproj" />
    <ProjectReference Include="..\..\..\..\src\apps\Tellma.Identity.Migrations\Tellma.Identity.Migrations.csproj" />
    <!-- The email pipeline, because in-proc the hosting distribution composes it — that is the
         parity this asset exists to prove. No transport adapter: the pipeline registers the
         development log sink itself, which is all a test host needs. -->
    <ProjectReference Include="..\..\..\..\src\core\Tellma.Core.Email\Tellma.Core.Email.csproj" />
  </ItemGroup>

</Project>
