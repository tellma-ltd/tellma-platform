<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The suite drives the data layer directly, the way only the runtime does: its raw
         statements are held in fields or built to provoke the batch's own run-time refusals
         (TELLMA0003), and its test classes, which own no stack, write the fixture's and the
         platform's entity tables (TELLMA0006). The analyzer suite pins both rules instead. -->
    <NoWarn>$(NoWarn);TELLMA0003;TELLMA0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Tellma.Testing.Support.Sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\Tellma.Core\Tellma.Core.csproj" />
    <!-- The platform-owned catalog migrations, applied to every fresh catalog the suite creates,
         and their design-time factory. -->
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.Migrator\Tellma.Core.Migrator.csproj" />
    <!-- A distribution's migrator project in miniature: the composition and tenant migrations the
         migrator's commands are driven with. -->
    <ProjectReference Include="..\assets\Tellma.Core.Migrator.TestDistribution\Tellma.Core.Migrator.TestDistribution.csproj" />
    <!-- The web host's tracing configuration, run against a real SQL Server. -->
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.AspNetCore\Tellma.Core.AspNetCore.csproj" />
    <!-- The data layer's shared SQL fixture: the fixture schema, its migrations, and the host that
         opens a tenant database over a fixture database. -->
    <ProjectReference Include="..\..\shared\Tellma.Testing.Entities\Tellma.Testing.Entities.csproj" />
    <!-- The SQL Server every integration suite shares: a container, or the server TELLMA_TEST_SQL names. -->
    <ProjectReference Include="..\..\shared\Tellma.Testing.Support\Tellma.Testing.Support.csproj" />
    <!-- In-memory configuration for the compositions the suite builds over its catalogs. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <!-- FakeLogger and MetricCollector, for the best-effort membership writes. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
