<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Using Include="Tellma.Testing.Support.Sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.Queryex\Tellma.Core.Queryex.csproj" />
    <ProjectReference Include="..\..\shared\Tellma.Queryex.Testing\Tellma.Queryex.Testing.csproj" />
    <!-- The platform collation the fixture's database is created in. -->
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.Abstractions\Tellma.Core.Abstractions.csproj" />
    <!-- The SQL Server every integration suite shares: a container, or the server TELLMA_TEST_SQL names. -->
    <ProjectReference Include="..\..\shared\Tellma.Testing.Support\Tellma.Testing.Support.csproj" />
    <!-- Executes the emitted SQL directly. This suite deliberately does not go through EF Core —
         it is comparing the engine's own output against the reference interpreter, so anything
         between it and the server would blur what is being tested. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
