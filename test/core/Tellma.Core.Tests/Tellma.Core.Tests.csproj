<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The suite drives the data layer directly, the way only the runtime does: its raw
         statements are held in fields or built to provoke the batch's own run-time refusals
         (TELLMA0003), and its test classes, which own no stack, write the fixture's and the
         platform's entity tables (TELLMA0006). The analyzer suite pins both rules instead. -->
    <NoWarn>$(NoWarn);TELLMA0003;TELLMA0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\Tellma.Core\Tellma.Core.csproj" />
    <!-- Dogfoods the shipped test package: the blob-store conformance suite runs against the
         file-system store. -->
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.Testing\Tellma.Core.Testing.csproj" />
    <ProjectReference Include="..\..\shared\Tellma.Testing.Support\Tellma.Testing.Support.csproj" />
    <!-- The platform-owned catalog migrations and their design-time factory, which the collation
         and latest-migration pins and the catalog model's column pin read. -->
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.Migrator\Tellma.Core.Migrator.csproj" />
    <!-- The tenant model's migration is scaffolded the way a distribution's migrator scaffolds it:
         with the table-type design-time services, the EF Design package and Roslyn to compile
         the scaffolded code back in. The Design package is developmentDependency=true, so it is
         referenced directly, as a migrator project references it. -->
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.EntityFrameworkCore.Design\Tellma.Core.EntityFrameworkCore.Design.csproj" />
    <!-- The web host, so the context's writer pin searches its tenant middleware too. -->
    <ProjectReference Include="..\..\..\src\core\Tellma.Core.AspNetCore\Tellma.Core.AspNetCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>none</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- In-memory configuration for the compositions under test. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <!-- MetricCollector and FakeLogger, for the store instruments and log events. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <!-- A real generic host, so the startup gate runs the way a deployment starts it. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- FakeTimeProvider, so the registry's refresh timer, staleness bound and first-load bound run
         on a clock the suite moves. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The launch-landing vectors the client's launch redirect reads too: one rule, one file. -->
    <None Include="../../../client/projects/core/tellma-core/src/launch/launch-landing-vectors.json" Link="Tenancy\launch-landing-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The display-name golden the client's renderer reads too: one rule, one file. -->
    <None Include="../../../client/projects/core/tellma-core/src/entity/display-name-golden.json" Link="Data\Queries\display-name-golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
