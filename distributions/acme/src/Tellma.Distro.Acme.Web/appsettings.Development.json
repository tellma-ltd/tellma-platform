{
  // Local development from a fresh clone: the in-proc identity engine over a LocalDB catalog,
  // signed in as the development administrator with the code the console prints. The ports are
  // the fallbacks; a worktree's .dev-ports.local overrides them.
  "Tellma": {
    "PublicOrigin": "https://localhost:4200",
    "Catalog": {
      "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=Tellma.dev.acme.catalog;Integrated Security=True;TrustServerCertificate=True"
    },
    "Sql": {
      "Profiles": {
        "default": "Integrated Security=True;TrustServerCertificate=True"
      }
    },
    "Identity": {
      "Mode": "InProc"
    },
    // What the migrator's migrate command registers and provisions when the catalog lacks it.
    "Seed": {
      "AdminEmail": "admin@localhost",
      "Tenants": [
        {
          "Id": 1,
          "Name": "Acme",
          "Category": "Live",
          "Languages": [ "en", "ar" ],
          "Calendars": [ "gc", "uq" ]
        },
        {
          "Id": 2,
          "Name": "Acme Sandbox",
          "Category": "Sandbox",
          "LiveTenantId": 1,
          "Languages": [ "en", "ar" ],
          "Calendars": [ "gc", "uq" ]
        }
      ]
    }
  },
  // The in-proc engine's own settings; the platform dictates its mode, path, issuer, store and
  // the distribution's client.
  "TellmaIdentity": {
    "Keys": {
      "Signing": { "Source": "DevelopmentSelfSigned" },
      "Encryption": { "Source": "DevelopmentSelfSigned" }
    },
    "Development": {
      "AllowDevelopmentCertificates": true
    },
    "Seed": {
      "DevAdmin": { "Enabled": true }
    }
  }
}
