{
  // Local development from a fresh clone: the in-proc identity engine over a LocalDB catalog,
  // signed in as the development administrator with the code the console prints. The ports are
  // the fallbacks; a worktree's .dev-ports.local overrides them. The browser reaches the app through
  // the client dev server, which the SPA proxy starts, so the public origin is the dev server's.
  "Tellma": {
    "PublicOrigin": "https://localhost:4200",
    "Catalog": {
      "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=Tellma.dev.acme.catalog;Integrated Security=True;TrustServerCertificate=True"
    },
    "Sql": {
      "Profiles": {
        "default": "Integrated Security=True;TrustServerCertificate=True;Max Pool Size=20"
      }
    },
    "Identity": {
      "Mode": "InProc"
    },
    // The reference distribution exercises support requests.
    "Support": {
      "Enabled": true
    },
    // What the migrator's migrate command registers and provisions when the catalog lacks it.
    "Seed": {
      "AdminEmail": "admin@localhost",
      "Tenants": [
        {
          "Id": 1,
          "Name": "Acme",
          "Category": "Live",
          "Languages": [ "en", "ar" ],
          "Calendars": [ "gc", "uq" ]
        },
        {
          "Id": 2,
          "Name": "Acme Sandbox",
          "Category": "Sandbox",
          "LiveTenantId": 1,
          "Languages": [ "en", "ar" ],
          "Calendars": [ "gc", "uq" ]
        }
      ]
    }
  },
  // The in-proc engine's own settings; the platform dictates its mode, path, issuer, store and
  // the distribution's client.
  "TellmaIdentity": {
    "Keys": {
      "Signing": { "Source": "DevelopmentSelfSigned" },
      "Encryption": { "Source": "DevelopmentSelfSigned" }
    },
    "Development": {
      "AllowDevelopmentCertificates": true
    },
    // The development administrator, and the sample data's end-to-end principals at the fixed
    // subjects their tenant users are bound to, so each signs in with an email code from a fresh
    // clone; AcmeDevelopmentPrincipals holds the same addresses and subjects.
    "Seed": {
      "DevAdmin": { "Enabled": true },
      "DevUsers": [
        { "Email": "sales@localhost", "Subject": "00000000-0000-0000-0000-000000000002", "DisplayName": "Sales Representative" },
        { "Email": "centers@localhost", "Subject": "00000000-0000-0000-0000-000000000003", "DisplayName": "Center Reader" },
        { "Email": "sandbox@localhost", "Subject": "00000000-0000-0000-0000-000000000004", "DisplayName": "Sandbox Tester" }
      ]
    }
  }
}
