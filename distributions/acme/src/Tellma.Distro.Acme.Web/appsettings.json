{
  // The settings every environment shares. A deployment supplies the rest (the public origin, the
  // catalog, the SQL profiles and allowed servers, the identity authority) through its own
  // configuration, and every secret through its secret store: nothing here is a secret.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    // The trace id is the reference the error page shows a user; a deployment with no collector
    // in front of it has nothing but this console to find it in.
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj} {TraceId}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Tellma": {
    "DisplayName": "Acme",
    "Identity": {
      "Mode": "Standalone"
    }
  }
}
