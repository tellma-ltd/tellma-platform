/* The application build's TypeScript configuration: the app from its entry file and the emitted entity types, without the specs. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./out-tsc/app",
    "types": []
  },
  "include": ["generated/*.d.ts"],
  "files": ["src/main.ts"]
}
