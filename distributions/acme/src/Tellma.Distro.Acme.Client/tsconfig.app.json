/* The application build's TypeScript configuration: the app from its entry file and the emitted entity types, without the specs. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./out-tsc/app",
    "types": []
  },
  /*
   * Inside the platform's repository, the shell entry point is listed too:
   * the framework loads it with import() through a specifier the compiler
   * does not follow, and a build from sources compiles only what the
   * program holds. An installed package needs no such line.
   */
  "include": ["generated/*.d.ts", "../../../../client/projects/core/tellma-core/shell/public-api.ts"],
  "files": ["src/main.ts"]
}
