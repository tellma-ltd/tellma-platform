{
  "name": "tellma-distro-acme-client",
  "version": "0.0.0",
  "description": "The Acme reference distribution's single-page app: its features, languages, manifest and theme over the Tellma app framework.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tellma-client serve",
    "build": "tellma-client build",
    "build:esproj": "tellma-client build --no-dotnet-build",
    "test": "ng test",
    "lint": "eslint . && stylelint \"src/**/*.css\""
  },
  "tellma": {
    "migrator": "../Tellma.Distro.Acme.Migrator",
    "budgets": {
      "initialJs": {
        "warn": 238.5,
        "note": "The warn line is the app's measure rounded up to the next 0.5 KB, so growth shows as a warning well before the 260 KB error line: 236.87 KB on a clean build with the bell and the tray and the pinned bar, then 238.37 KB once the home route's chunk imports the attention entry point, which the build then splits from the shell's into a modulepreloaded file of its own."
      }
    }
  },
  "dependencies": {
    "@angular/aria": "catalog:",
    "@angular/cdk": "catalog:",
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@angular/service-worker": "catalog:",
    "@internationalized/date": "catalog:",
    "@jsverse/transloco": "catalog:",
    "lucide": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@playwright/test": "catalog:",
    "@tellma/core-tools": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
